{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seguros-gestoria-arroyo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Sin direcciones de vista previa: cada versión subida no queda accesible por su cuenta.
  "preview_urls": false,

  // La web: ficheros estáticos de `out/` (los genera `next build`). Cloudflare
  // los sirve directamente, sin ejecutar el Worker, salvo en /panel y /api.
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/panel", "/panel/*", "/api/*"]
  },

  // Base de datos del panel: personas, campañas e imágenes.
  // (El nombre "…-tags" viene del montaje anterior; la base estaba vacía.)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seguros-gestoria-arroyo-tags",
      "database_id": "6b51d59d-7de2-4269-bb4e-baf71ba126c5",
      "migrations_dir": "worker/migraciones"
    }
  ],

  // Cada 5 minutos: publica lo que haya quedado pendiente (cambios que ninguna
  // compilación recogió y campañas programadas que llegan a su fecha).
  "triggers": { "crons": ["*/5 * * * *"] },

  // Asistente de la web (worker/chat.ts). El modelo se puede cambiar aquí sin tocar código:
  // "claude-opus-5-5" (el más capaz), "claude-sonnet-5-5" o "claude-haiku-5-5" (el más barato).
  // LIMITE_CHAT_DIARIO es el tope de mensajes al día entre todos los visitantes.
  "vars": {
    "MODELO_CHAT": "claude-opus-5-5",
    "LIMITE_CHAT_DIARIO": "300"
  },

  // Secretos del Worker (DESPLIEGUE.md); se ponen con `npx wrangler secret put <NOMBRE>`:
  //   DEPLOY_HOOK_URL     dirección del deploy hook que compila y publica la web
  //   TOKEN_LECTURA       lo presenta la compilación para leer las campañas
  //   ANTHROPIC_API_KEY   clave de la API de Anthropic para el asistente de la web

  // Dominio definitivo. `workers_dev: false` apaga la dirección de pruebas
  // (*.workers.dev): la web y el panel solo existen en el dominio.
  "workers_dev": false,
  "routes": [{ "pattern": "segurosgestoriaarroyo.com", "custom_domain": true }]
}
