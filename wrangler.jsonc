{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seguros-gestoria-arroyo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Sin direcciones de vista previa: cada versión subida no queda accesible por su cuenta.
  "preview_urls": false,

  // La web: ficheros estáticos de `out/` (los genera `next build`). Cloudflare
  // los sirve directamente, sin ejecutar el Worker, salvo en /panel y /api.
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/panel", "/panel/*", "/api/*"]
  },

  // Base de datos del panel: personas, campañas e imágenes.
  // (El nombre "…-tags" viene del montaje anterior; la base estaba vacía.)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seguros-gestoria-arroyo-tags",
      "database_id": "6b51d59d-7de2-4269-bb4e-baf71ba126c5",
      "migrations_dir": "worker/migraciones"
    }
  ],

  // Cada hora: publica las campañas programadas que han llegado a su fecha.
  "triggers": { "crons": ["5 * * * *"] }

  // Secretos del Worker (DESPLIEGUE.md); se ponen con `npx wrangler secret put <NOMBRE>`:
  //   DEPLOY_HOOK_URL   dirección del deploy hook que compila y publica la web
  //   TOKEN_LECTURA     lo presenta la compilación para leer las campañas

  // Dominio propio: descomentar cuando el dominio esté en Cloudflare. Añadir entonces
  // también  "workers_dev": false  para que el panel solo exista en el dominio.
  // ,"routes": [
  //   { "pattern": "segurosgestoriaarroyo.com", "custom_domain": true }
  // ]
}
