# Copia este fichero a .env.local y rellena los valores.

# Sanity (público: se usa también en el navegador para el Studio embebido)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Secreto compartido con el webhook de Sanity para revalidar la caché (ISR)
SANITY_REVALIDATE_SECRET=

# URL pública del sitio (para metadatos, sitemap y robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
