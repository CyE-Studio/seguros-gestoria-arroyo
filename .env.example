# Copia este fichero a .env.local y rellena los valores.

# URL pública del sitio (para metadatos, sitemap y robots). Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Código de verificación de Google Search Console (opcional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Token de Cloudflare Web Analytics (opcional). Sin él no se carga el contador de visitas.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Las campañas se leen del panel al compilar:
#   PANEL_URL=https://dominio npm run contenido
# Sin PANEL_URL la web se compila en modo demostración (campañas de ejemplo).
