{
  "name": "seguros-gestoria-arroyo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "contenido": "node scripts/traer-campanas.mjs",
    "comprobar": "node scripts/comprobar-produccion.mjs",
    "panel:dev": "wrangler d1 migrations apply DB --local && wrangler dev",
    "panel:invitar": "node scripts/invitar.mjs",
    "cf:build": "node scripts/comprobar-produccion.mjs && node scripts/traer-campanas.mjs && next build",
    "cf:publicar": "wrangler d1 migrations apply DB --remote && wrangler deploy && node scripts/indexnow.mjs",
    "cf:deploy:inicial": "node scripts/comprobar-produccion.mjs && node scripts/traer-campanas.mjs --vacio && next build && npm run cf:publicar",
    "cf:www": "wrangler deploy -c redireccion-www/wrangler.jsonc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.0": true,
    "workerd@1.20261104.1": true
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
